* stata14-mp -b do test/unit-tests-consistency.do
*
* Automated Stata-vs-R consistency checks. Each honestdid call is compared
* against cached R results in test/r-results/ (generated by running
* test/unit-tests-consistency.R). If the directory does not exist, checks
* are skipped and only the log output is produced.
*
* To regenerate R results:
*
*     Rscript --no-save --no-restore --verbose test/unit-tests-consistency.R

clear all
log close _all
log using test/unit-tests-consistency.do.log, replace
set rmsg on

* Consistency check helper: compare honestdid CI against an R CSV.
* Expects to be called right after a honestdid call that populated
* the mata struct named in `matasave'.
capture program drop consistency_check
program consistency_check
    syntax, rfile(str) tol(real) matasave(str) [rm]
    capture confirm file "`rfile'"
    if _rc {
        di as txt "  (skipped: `rfile' not found)"
        exit 0
    }
    else {
        di as txt "  (checking: `rfile')"
    }

    preserve
    qui import delimited using `"`rfile'"', clear
    tempname R_vals S_vals S_ci
    tempname mlb mub lb ub mtol msg fail
    mata {

        `mtol'   = strtoreal(st_local("tol"))
        `R_vals' = st_data(., "m lb ub")
        `S_ci'   = `matasave'.CI

        // Strip OG row(s) where M == .
        if ( "`rm'" == "" ) {
            if ( cols(`S_ci') == 3 ) {
                `S_vals' = select(`S_ci', `S_ci'[.,1] :!= .)
            }
            else {
                `S_vals' = select(`S_ci'[., 2..4], `S_ci'[., 2] :!= .)
            }
        }
        else {
            `S_vals' = editmissing(`S_ci', 0)
        }

        if ( rows(`S_vals') != rows(`R_vals') ) {
            `msg' = sprintf("check failed: row mismatch: Stata %g vs R %g", rows(`S_vals'), rows(`R_vals'))
            errprintf("%s\n", `msg')
            _error(198)
        }

        // Check M values match
        if ( mreldif(`S_vals'[.,1], `R_vals'[.,1]) > 1e-6 ) {
            errprintf("check failed: M values do not match between Stata and R\n")
            _error(198)
        }

        // Check lb and ub
        `mlb'  = reldif(`S_vals'[.,2], `R_vals'[.,2])
        `mub'  = reldif(`S_vals'[.,3], `R_vals'[.,3])
        `lb'   = max(`mlb')
        `ub'   = max(`mub')
        `fail' = (`lb' > `mtol') | (`ub' > `mtol')

        // Slightly more tolerant fail condition
        if ( `fail' ) {
            `fail' = (`lb' > sqrt(`mtol')) | (`ub' > sqrt(`mtol'))
            if ( `fail' | (sum(`lb' :> `mtol') > 1) | (sum(`ub' :> `mtol') > 1) ) {
                errprintf("Tolerance exceeded (tol=%g): reldif lb=%g, ub=%g\n", `mtol', `lb', `ub')
                errprintf("  Stata CI:\n"); `S_vals'
                errprintf("  R CI:\n");     `R_vals'
                _error(198)
            }
            else {
                printf("check WARNING (reldif lb=%g, ub=%g)\n", `lb', `ub')
            }
        }
        else {
            printf("check passed (reldif lb=%g, ub=%g)\n", `lb', `ub')
        }
    }
    restore
end

* ---------------------------------------------------------------------
* Setup
* ---------------------------------------------------------------------

local OUT test/r-results
tempname beta sigma
mata {
    st_matrix(st_local("beta"),  _honestExampleBCBeta())
    st_matrix(st_local("sigma"), _honestExampleBCSigma())
}
* tol is 3 significant digits (with rounding)
local TOL 5e-3

disp _n "-----------------------------------"
disp    "Base relative magnitudes comparison"
disp _n "-----------------------------------"

tempname r
honestdid, numpre(4) b(`beta') vcov(`sigma') matasave(`r')
consistency_check, rfile(`OUT'/bc_rm_default.csv) tol(`TOL') matasave(`r') rm

mata st_matrix("l_vec", _honestBasis(1, 4))
mata st_matrix("l_alt", J(4, 1, 1)/4)

local opts mvec(0(0.5)2) gridPoints(100) grid_lb(-1) grid_ub(1) l_vec(l_vec)
honestdid, numpre(4) b(`beta') vcov(`sigma') `opts' matasave(`r')
consistency_check, rfile(`OUT'/bc_rm_lvec_clf.csv) tol(`TOL') matasave(`r')

honestdid, numpre(4) b(`beta') vcov(`sigma') `opts' method(Conditional) matasave(`r')
consistency_check, rfile(`OUT'/bc_rm_lvec_conditional.csv) tol(`TOL') matasave(`r')

local opts mvec(0(0.5)2) gridPoints(100) grid_lb(-1) grid_ub(1) l_vec(l_alt)
honestdid, numpre(4) b(`beta') vcov(`sigma') `opts' matasave(`r')
consistency_check, rfile(`OUT'/bc_rm_lalt_clf.csv) tol(`TOL') matasave(`r')

honestdid, numpre(4) b(`beta') vcov(`sigma') `opts' method(Conditional) matasave(`r')
consistency_check, rfile(`OUT'/bc_rm_lalt_conditional.csv) tol(`TOL') matasave(`r')

disp _n "----------------------"
disp    "Base non-rm comparison"
disp _n "----------------------"

honestdid, numpre(4) b(`beta') vcov(`sigma') delta(sd) matasave(`r')
consistency_check, rfile(`OUT'/bc_sd_default.csv) tol(`TOL') matasave(`r')

local opts numpre(4) delta(sd) mvec(0(0.1)0.3) l_vec(l_vec)
foreach meth in FLCI Conditional C-F C-LF {
    local tag = lower(subinstr("`meth'", "-", "", .))
    honestdid, b(`beta') vcov(`sigma') `opts' method(`meth') matasave(`r')
    consistency_check, rfile(`OUT'/bc_sd_lvec_`tag'.csv) tol(`TOL') matasave(`r')
}

local opts numpre(4) delta(sd) mvec(0(0.1)0.3) l_vec(l_alt)
foreach meth in FLCI Conditional C-F C-LF {
    local tag = lower(subinstr("`meth'", "-", "", .))
    honestdid, b(`beta') vcov(`sigma') `opts' method(`meth') matasave(`r')
    consistency_check, rfile(`OUT'/bc_sd_lalt_`tag'.csv) tol(`TOL') matasave(`r')
}

disp _n "-----------------------"
disp    "Large non-rm comparison"
disp _n "-----------------------"

mata st_matrix("l_vec", _honestBasis(15 - (-2), 23))
mata st_matrix("l_alt", J(23, 1, 1)/23)

clear
local rdir test/r-results
import delimited using "`rdir'/lw_betahat.csv", clear
mata st_matrix("b_R", st_data(., "betahat")')
import delimited using "`rdir'/lw_sigma.csv", clear
mata st_matrix("V_R", st_data(., .))

* NOTE: Even though R and Stata regression results are very close, small
* NOTE: numerical precision differences propagate and end up causing the
* NOTE: checks to fail.
*
* use test/LWdata_RawData.dta, clear
* mata stata(_honestExampleLWCall())
*
* local adj = (e(N) - e(df_m) - e(df_a)) / (e(N)-e(df_m))
* matrix b  = 100 * e(b)
* matrix V  = 100^2 * e(V) * `adj'
* matrix b  = b[1,1..32]
* matrix V  = V[1..32,1..32]
*
* mata st_matrix("b_R")' :/ st_matrix("b")
* mata st_matrix("V_R")  :/ st_matrix("V")
matrix b = b_R
matrix V = V_R

honestdid, pre(1/9) post(10/32) b(b) vcov(V) delta(sd) matasave(`r')
consistency_check, rfile(`OUT'/lw_sd_default.csv) tol(`TOL') matasave(`r')

local opts delta(sd) mvec(0(0.005)0.04) l_vec(l_vec)
foreach meth in FLCI Conditional C-F C-LF {
    local tag = lower(subinstr("`meth'", "-", "", .))
    honestdid, pre(1/9) post(10/32) b(b) vcov(V) `opts' method(`meth') matasave(`r')
    consistency_check, rfile(`OUT'/lw_sd_lvec_`tag'.csv) tol(`TOL') matasave(`r')
}

