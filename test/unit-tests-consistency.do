disp    "One post-period"
disp _n "---------------"

local opts mvec(0(0.1)0.3) delta(sd) numpre(7)
foreach meth in FLCI Conditional C-F C-LF {
    local tag = lower(subinstr("`meth'", "-", "", .))
    honestdid, b(`beta') vcov(`sigma') `opts' method(`meth') matasave(`r')
    consistency_check, rfile(`OUT'/onepost_sd_`tag'.csv) tol(`TOL') matasave(`r')
}

disp _n
disp "As of April, 2026, R has a narrower interval here and hits the limit"
disp "where Stata does not, leading to a discrepancy."
disp _n

local opts mvec(0(0.5)2) delta(rm) numpre(7)
foreach meth in Conditional C-LF {
    local tag = lower(subinstr("`meth'", "-", "", .))
    honestdid, b(`beta') vcov(`sigma') `opts' method(`meth') matasave(`r')
    cap noi consistency_check, rfile(`OUT'/onepost_rm_`tag'.csv) tol(`TOL') matasave(`r')
}

