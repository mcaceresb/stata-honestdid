. 
. * Consistency check helper: compare honestdid CI against an R CSV.
. * Expects to be called right after a honestdid call that populated
. * the mata struct named in `matasave'.
. capture program drop consistency_check
r; t=0.00 21:47:39

. program consistency_check
  1.     syntax, rfile(str) tol(real) matasave(str) [rm]
  2.     capture confirm file "`rfile'"
  3.     if _rc {
  4.         di as txt "  (skipped: `rfile' not found)"
  5.         exit 0
  6.     }
  7.     else {
  8.         di as txt "  (checking: `rfile')"
  9.     }
 10. 
.     preserve
 11.     qui import delimited using `"`rfile'"', clear
 12.     tempname R_vals S_vals S_ci
 13.     tempname mlb mub lb ub mtol msg fail
 14.     mata {
 15. 
.         `mtol'   = strtoreal(st_local("tol"))
 16.         `R_vals' = st_data(., "m lb ub")
 17.         `S_ci'   = `matasave'.CI
 18. 
.         // Strip OG row(s) where M == .
.         if ( "`rm'" == "" ) {
 19.             if ( cols(`S_ci') == 3 ) {
 20.                 `S_vals' = select(`S_ci', `S_ci'[.,1] :!= .)
 21.             }
 22.             else {
 23.                 `S_vals' = select(`S_ci'[., 2..4], `S_ci'[., 2] :!= .)
 24.             }
 25.         }
 26.         else {
 27.             `S_vals' = editmissing(`S_ci', 0)
 28.         }
 29. 
.         if ( rows(`S_vals') != rows(`R_vals') ) {
 30.             `msg' = sprintf("check failed: row mismatch: Stata %g vs R %g"
> , rows(`S_vals'), rows(`R_vals'))
 31.             errprintf("%s\n", `msg')
 32.             _error(198)
 33.         }
 34. 
.         // Check M values match
.         if ( mreldif(`S_vals'[.,1], `R_vals'[.,1]) > 1e-6 ) {
 35.             errprintf("check failed: M values do not match between Stata a
> nd R\n")
 36.             _error(198)
 37.         }
 38. 
.         // Check lb and ub
.         `mlb'  = reldif(`S_vals'[.,2], `R_vals'[.,2])
 39.         `mub'  = reldif(`S_vals'[.,3], `R_vals'[.,3])
 40.         `lb'   = max(`mlb')
 41.         `ub'   = max(`mub')
 42.         `fail' = (`lb' > `mtol') | (`ub' > `mtol')
 43. 
.         // Slightly more tolerant fail condition
.         if ( `fail' ) {
 44.             `fail' = (`lb' > sqrt(`mtol')) | (`ub' > sqrt(`mtol'))
 45.             if ( `fail' | (sum(`lb' :> `mtol') > 1) | (sum(`ub' :> `mtol')
>  > 1) ) {
 46.                 errprintf("Tolerance exceeded (tol=%g): reldif lb=%g, ub=%
> g\n", `mtol', `lb', `ub')
 47.                 errprintf("  Stata CI:\n"); `S_vals'
 48.                 errprintf("  R CI:\n");     `R_vals'
 49.                 _error(198)
 50.             }
 51.             else {
 52.                 printf("check WARNING (reldif lb=%g, ub=%g)\n", `lb', `ub'
> )
 53.             }
 54.         }
 55.         else {
 56.             printf("check passed (reldif lb=%g, ub=%g)\n", `lb', `ub')
 57.         }
 58.     }
 59.     restore
 60. end
